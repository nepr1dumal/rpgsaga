
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="950" background="#121212">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Game -->
    <mxCell id="game" value="Game" style="swimlane;fontStyle=1;startSize=32;fillColor=#1C242E;swimlaneFillColor=#141414;strokeColor=#657786;fontColor=#B4D4EF;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="60" y="60" width="290" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="gameFields" value="+ HeroesAvailable: List&lt;Hero&gt;" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="game">
      <mxGeometry y="40" width="290" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="gameMethods" value="+ Run(): void&#xa;- Populate(): void" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="game">
      <mxGeometry y="85" width="290" height="65" as="geometry"/>
    </mxCell>

    <!-- Round -->
    <mxCell id="round" value="Round" style="swimlane;fontStyle=1;startSize=32;fillColor=#1C242E;swimlaneFillColor=#141414;strokeColor=#657786;fontColor=#B4D4EF;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="460" y="60" width="310" height="235" as="geometry"/>
    </mxCell>
    <mxCell id="roundFields" value="+ Heroes: List&lt;Hero&gt;&#xa;+ Duels: List&lt;Duel&gt;&#xa;+ Winners: List&lt;Hero&gt;&#xa;+ Finish: bool" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="round">
      <mxGeometry y="40" width="310" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="roundMethods" value="+ Round(heroes: List&lt;Hero&gt;)&#xa;- MakeListOfDuels(): List&lt;Duel&gt;&#xa;+ Play(): List&lt;Hero&gt;" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="round">
      <mxGeometry y="135" width="310" height="90" as="geometry"/>
    </mxCell>

    <!-- Duel -->
    <mxCell id="duel" value="Duel" style="swimlane;fontStyle=1;startSize=32;fillColor=#1C242E;swimlaneFillColor=#141414;strokeColor=#657786;fontColor=#B4D4EF;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="880" y="60" width="310" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="duelFields" value="+ First: Hero&#xa;+ Second: Hero" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="duel">
      <mxGeometry y="40" width="310" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="duelMethods" value="+ Duel(first: Hero, second: Hero)&#xa;+ Fight(): Hero?" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="duel">
      <mxGeometry y="100" width="310" height="60" as="geometry"/>
    </mxCell>

    <!-- Hero -->
    <mxCell id="hero" value="«abstract»&#xa;Hero" style="swimlane;fontStyle=3;startSize=46;fillColor=#272337;swimlaneFillColor=#141414;strokeColor=#657786;fontColor=#B4D4EF;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="390" y="410" width="450" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="heroFields" value="+ Hp: int&#xa;+ MaxHp: int&#xa;+ Name: string&#xa;+ Damage: int" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="hero">
      <mxGeometry y="54" width="450" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="heroMethods" value="+ Hero(maxHp: int, hp: int, name: string, damage: int)&#xa;+ IsAlive(): bool&#xa;+ TakeDamage(damage: int): void" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="hero">
      <mxGeometry y="145" width="450" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="heroAttack" value="+ Attack(target: Hero): void" style="text;html=0;fontStyle=2;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="hero">
      <mxGeometry y="215" width="450" height="30" as="geometry"/>
    </mxCell>

    <!-- TestHero -->
    <mxCell id="testHero" value="TestHero" style="swimlane;fontStyle=1;startSize=32;fillColor=#272337;swimlaneFillColor=#141414;strokeColor=#657786;fontColor=#B4D4EF;rounded=0;" vertex="1" parent="1">
      <mxGeometry x="390" y="770" width="450" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="testHeroMethods" value="+ TestHero(maxHp: int, hp: int, name: string, damage: int)&#xa;+ Attack(target: Hero): void" style="text;html=0;align=left;verticalAlign=top;fontColor=#FFFFFF;spacingLeft=8;" vertex="1" parent="testHero">
      <mxGeometry y="45" width="450" height="60" as="geometry"/>
    </mxCell>

    <!-- Game -> Round: dependency -->
    <mxCell id="gameRound" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;" edge="1" parent="1" source="game" target="round">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Round -> Duel: composition -->
    <mxCell id="roundDuel" value="Duels 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;" edge="1" parent="1" source="round" target="duel">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Game -> Hero: aggregation -->
    <mxCell id="gameHero" value="HeroesAvailable 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=diamond;startFill=0;endArrow=none;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0.5;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="game" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Round -> Hero: participants -->
    <mxCell id="roundHero" value="Heroes 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=diamond;startFill=0;endArrow=none;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0.25;exitY=1;entryX=0.33;entryY=0;" edge="1" parent="1" source="round" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Round -> Hero: winners -->
    <mxCell id="roundWinners" value="Winners 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=diamond;startFill=0;endArrow=none;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0.75;exitY=1;entryX=0.67;entryY=0;" edge="1" parent="1" source="round" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Duel -> Hero: First -->
    <mxCell id="duelFirst" value="First 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0.25;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="duel" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Duel -> Hero: Second -->
    <mxCell id="duelSecond" value="Second 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0.75;exitY=1;entryX=1;entryY=0.65;" edge="1" parent="1" source="duel" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- TestHero -> Hero: inheritance -->
    <mxCell id="inheritance" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=0;endSize=16;strokeColor=#91A4B7;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="testHero" target="hero">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Game -> TestHero: dependency -->
    <mxCell id="gameTestHero" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;endArrow=open;endFill=0;strokeColor=#91A4B7;fontColor=#B4D4EF;labelBackgroundColor=#121212;exitX=0;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="game" target="testHero">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="30" y="188"/>
          <mxPoint x="30" y="825"/>
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>
